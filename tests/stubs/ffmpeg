#!/usr/bin/env python3
"""Stand-in for ffmpeg: logs its arguments and writes a small MP4-looking file at the output path."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _stub  # noqa: E402

a = sys.argv[1:]
_stub.log("ffmpeg")
if a[:1] in (["-version"], ["--version"]):
    print("ffmpeg version 8.0-stub")
    sys.exit(0)
if os.environ.get("STUB_FFMPEG_FAIL"):
    print("ffmpeg stub: forced failure", file=sys.stderr)
    sys.exit(1)
out = a[-1]
with open(out, "wb") as f:
    f.write(b"\x00\x00\x00\x18ftypmp42\x00\x00\x00\x00mp42isom" + b"\x00" * 64)
sys.exit(0)
