#!/usr/bin/env python3
"""imgops: the few image operations the painters need, on whatever this machine has.

Pillow when it imports, else macOS sips, else nothing: then the command exits 3 and the
painter delivers its own untouched file instead of failing after the plan already paid.

Usage:
  imgops backend                 print pillow, sips or none (exit 3 for none)
  imgops dims IMG                print WxH (PNG and JPEG headers are read even with no backend)
  imgops convert SRC DST         re-encode SRC in DST's format (.png .jpg .jpeg .webp)
  imgops crop IMG W H            center-crop IMG in place to W x H
  imgops resize IMG W H          resize IMG in place to exactly W x H
  imgops pad SRC W:H DST         put SRC on a darkened blur of itself at aspect W:H (Pillow only);
                                 prints "WxH -> WxH", or nothing when SRC is within 15% of W:H

Exit: 0 done, 1 the operation failed, 2 usage, 3 no backend here can do it.
"""
import math
import os
import re
import shutil
import struct
import subprocess
import sys

try:
    from PIL import Image, ImageFilter, ImageOps
except ImportError:
    Image = None
SIPS = shutil.which("sips")
FORMATS = {".png": "PNG", ".jpg": "JPEG", ".jpeg": "JPEG", ".webp": "WEBP"}


class Unavailable(Exception):
    pass


def header_dims(path):
    with open(path, "rb") as f:
        d = f.read(1 << 16)
    if d[:8] == b"\x89PNG\r\n\x1a\n":
        return struct.unpack(">II", d[16:24])
    if d[:2] == b"\xff\xd8":
        i = 2
        while i + 9 < len(d):
            if d[i] != 0xFF:
                i += 1
                continue
            m = d[i + 1]
            if 0xC0 <= m <= 0xCF and m not in (0xC4, 0xC8, 0xCC):
                h, w = struct.unpack(">HH", d[i + 5:i + 9])
                return w, h
            i += 2 + struct.unpack(">H", d[i + 2:i + 4])[0]
    raise Unavailable("not a PNG or JPEG header, and no Pillow or sips to read it")


def sips(*args):
    subprocess.run([SIPS, *args], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)


def sips_best(path):
    return ["-s", "formatOptions", "best"] if os.path.splitext(path)[1].lower() in (".jpg", ".jpeg") else []


def pil_save(im, path, fmt):
    if fmt == "JPEG" and im.mode not in ("RGB", "L"):
        im = im.convert("RGB")
    im.save(path, fmt, **({"quality": 95} if fmt in ("JPEG", "WEBP") else {}))


def with_pillow(op, *a):
    """Run op with Pillow; fall back to sips for files Pillow cannot read (HEIC)."""
    if Image is not None:
        try:
            return op(*a)
        except Image.UnidentifiedImageError:
            if not SIPS:
                raise Unavailable("Pillow cannot read this file and sips is not here")
    return None


def dims(path):
    if Image is not None:
        try:
            with Image.open(path) as im:
                return "%dx%d" % im.size
        except Image.UnidentifiedImageError:
            pass
    if SIPS:
        out = subprocess.run([SIPS, "-g", "pixelWidth", "-g", "pixelHeight", path],
                             capture_output=True, text=True).stdout
        w, h = re.search(r"pixelWidth: (\d+)", out), re.search(r"pixelHeight: (\d+)", out)
        if w and h:
            return w.group(1) + "x" + h.group(1)
    return "%dx%d" % header_dims(path)


def convert(src, dst):
    fmt = FORMATS.get(os.path.splitext(dst)[1].lower())
    if not fmt:
        raise Unavailable("no image format for " + dst)

    def pil():
        with Image.open(src) as im:
            pil_save(im, dst, fmt)
        return True
    if with_pillow(pil):
        return
    if not SIPS or fmt == "WEBP":
        raise Unavailable("no Pillow" + ("" if SIPS else " and no sips"))
    sips("-s", "format", fmt.lower(), *sips_best(dst), src, "--out", dst)


def crop(path, w, h):
    def pil():
        with Image.open(path) as im:
            fmt = im.format
            x, y = (im.width - w) // 2, (im.height - h) // 2
            out = im.crop((x, y, x + w, y + h))
        pil_save(out, path, fmt)
        return True
    if with_pillow(pil):
        return
    if not SIPS:
        raise Unavailable("no Pillow and no sips")
    sips(*sips_best(path), "-c", str(h), str(w), path)


def resize(path, w, h):
    def pil():
        with Image.open(path) as im:
            fmt = im.format
            out = im.resize((w, h), Image.LANCZOS)
        pil_save(out, path, fmt)
        return True
    if with_pillow(pil):
        return
    if not SIPS:
        raise Unavailable("no Pillow and no sips")
    sips(*sips_best(path), "-z", str(h), str(w), path)


def pad(src, aspect, dst):
    if Image is None:
        raise Unavailable("padding needs Pillow")
    tw, th = (int(x) for x in aspect.split(":"))
    im = ImageOps.exif_transpose(Image.open(src)).convert("RGB")
    if abs(math.log((im.width / im.height) / (tw / th))) < math.log(1.15):
        return
    W = max(im.width, round(im.height * tw / th))
    H = round(W * th / tw)
    if H < im.height:
        H = im.height
        W = round(H * tw / th)
    bg = ImageOps.fit(im, (W, H)).filter(ImageFilter.GaussianBlur(max(W, H) // 25))
    bg = Image.blend(bg, Image.new("RGB", bg.size, (0, 0, 0)), 0.35)
    fg = ImageOps.contain(im, (W, H))
    bg.paste(fg, ((W - fg.width) // 2, (H - fg.height) // 2))
    bg.save(dst, quality=92)
    print(f"{im.width}x{im.height} -> {W}x{H}")


def main(argv):
    ops = {"dims": (1, dims), "convert": (2, convert), "crop": (3, crop), "resize": (3, resize), "pad": (3, pad)}
    if argv[:1] == ["backend"]:
        name = "pillow" if Image is not None else "sips" if SIPS else "none"
        print(name)
        return 3 if name == "none" else 0
    if not argv or argv[0] not in ops or len(argv) != ops[argv[0]][0] + 1:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    args = argv[1:]
    if argv[0] in ("crop", "resize"):
        args = [args[0], int(args[1]), int(args[2])]
    try:
        out = ops[argv[0]][1](*args)
    except Unavailable as e:
        print(f"imgops {argv[0]}: unavailable: {e}", file=sys.stderr)
        return 3
    except (OSError, ValueError, subprocess.CalledProcessError) as e:
        print(f"imgops {argv[0]}: {e}", file=sys.stderr)
        return 1
    if out is not None:
        print(out)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
