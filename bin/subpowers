#!/usr/bin/env bash
# subpowers: the AI subscriptions you already pay for, as powers for every agent.
#
# Usage:
#   subpowers image "<prompt>" out.png [--painter P|council] [--size WxH] [--ref IMG]... [--refs NAME]
#   subpowers sheet NAME out.png [--painter P|all]      character sheet (front, sides, 3/4, close-up)
#   subpowers storyboard shots.txt OUTDIR [--refs NAME] [--painter P] [--size WxH] [--style "..."]
#   subpowers refs add NAME IMG...  |  refs list [NAME]  |  refs path NAME
#   subpowers slideshow OUT.webp IMG... [--width 880]    looping slider of your picks (plays in any README)
#   subpowers library find [WORDS] [--painter P] [--tag k=v]  every image you made, with its tags
#   subpowers doctor [--fix] [--smoke]  |  powers  |  update
#
# Painters (each runs on YOUR login, never an API key):
#   chatgpt      OpenAI's current image model through the codex CLI (ChatGPT plan). 60-100 s.
#   antigravity  Google's Nano Banana 2 through the Antigravity CLI (Google AI plan). ~20-40 s.
#   grok         xAI's Grok Imagine through the Grok CLI (SuperGrok plan). ~35-45 s.
# --painter auto (default): the first connected painter; if it fails (paused plan, quota), the next.
# --painter council (or all): every connected painter paints the same prompt in parallel, plus a side-by-side
#   sheet, so you pick the best one. SUBPOWERS_PAINTER sets the default.
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  d="$(cd "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$d/$src"
done
here="$(cd "$(dirname "$src")" && pwd)"
HOME_DIR="${SUBPOWERS_HOME:-$HOME/.subpowers}"
ORDER="chatgpt antigravity grok"

# The help is the header comment, read up to its first non-comment line so it cannot drift.
usage() { awk 'NR == 1 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' "$here/subpowers" >&2; exit "${1:-2}"; }
say() { echo "subpowers: $*" >&2; }

has_chatgpt() {
  local o; command -v codex >/dev/null 2>&1 || return 1
  o="$(codex login status 2>&1)" || true
  grep -qi chatgpt <<<"$o"
}
# A plan counts as ON only when its CLI answers as logged in (installed is not enough:
# a cancelled plan's CLI is still installed). Answers are cached for 10 minutes in
# ~/.cache/subpowers so a fan-out checks once; a painter that reports the plan
# feature is missing marks itself OFF there too.
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/subpowers"
login_cached() {  # login_cached <painter> <check-fn>
  local f="$CACHE_DIR/login-$1"
  if [[ -n "$(find "$f" -mmin -10 2>/dev/null)" ]]; then [[ "$(cat "$f")" == on ]]; return; fi
  mkdir -p "$CACHE_DIR"
  if "$2"; then echo on >"$f"; else echo off >"$f"; return 1; fi
}
mark_off() { mkdir -p "$CACHE_DIR"; echo off >"$CACHE_DIR/login-$1"; }
# Stock macOS has no timeout(1); perl's alarm does the same job there.
tmo() {
  if command -v timeout >/dev/null 2>&1; then timeout 45 "$@"
  elif command -v perl >/dev/null 2>&1; then perl -e 'alarm shift; exec @ARGV' 45 "$@"
  else "$@"; fi
}
# Output is captured before grep: under pipefail, `cli | grep -q` fails when grep exits
# early and the CLI dies of SIGPIPE, which read a logged-in plan as OFF (2026-09-26).
chk_antigravity() {
  local a o; a="$(command -v agy 2>/dev/null || echo "$HOME/.local/bin/agy")"
  [[ -x "$a" ]] || return 1
  o="$(cd "${TMPDIR:-/tmp}" && tmo "$a" models 2>&1)" || true
  grep -q '^gemini-' <<<"$o"
}
chk_grok() {
  local o; command -v grok >/dev/null 2>&1 || return 1
  o="$(cd "${TMPDIR:-/tmp}" && tmo grok models 2>&1)" || true
  grep -qi 'logged in with grok.com' <<<"$o"
}
has_antigravity() { login_cached antigravity chk_antigravity; }
has_grok() { login_cached grok chk_grok; }
has() { case "$1" in chatgpt) has_chatgpt ;; antigravity) has_antigravity ;; grok) has_grok ;; *) return 1 ;; esac; }
connected() { local p out=""; for p in $ORDER; do has "$p" && out="$out $p"; done; echo "${out# }"; }
norm_painter() {
  case "$1" in
    openai|gpt) echo chatgpt ;;
    google|gemini|nano-banana|nanobanana) echo antigravity ;;
    xai|imagine|grok-imagine|supergrok) echo grok ;;
    council|everyone|every) echo all ;;   # council: every subscription paints it, you pick the best
    *) echo "$1" ;;
  esac
}

# Reference sets: $SUBPOWERS_HOME/refs/NAME/*.{jpg,jpeg,png,webp,heic}. Hidden and ._ files are skipped.
ref_files() {
  local dir="$HOME_DIR/refs/$1"
  [[ -d "$dir" ]] || { say "no reference set '$1' (make one: subpowers refs add $1 photo1.jpg photo2.jpg)"; return 3; }
  find "$dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.heic' \) ! -name '.*' | sort
}

# Run one painter; on a non-usage failure in auto mode, try the next connected painter.
# Antigravity takes at most 3 references, so extra ones are dropped for it (with a note).
paint() {  # paint <painter|auto> <prompt> <out> [painter args...]
  local want="$1" prompt="$2" out="$3"; shift 3
  local tries rc p got
  if [[ "$want" == auto ]]; then tries="$(connected)"; else tries="$want"; fi
  [[ -n "$tries" ]] || { say "no painter is connected. Run: subpowers doctor"; return 3; }
  for p in $tries; do
    has "$p" || { say "$p is not connected (paused or logged out); skipping"; continue; }
    local args=() nref=0 a skip=""
    for a in "$@"; do
      if [[ -n "$skip" ]]; then
        skip=""; nref=$((nref+1))
        if [[ "$p" == antigravity && $nref -gt 3 ]]; then continue; fi
        args+=(--ref "$a"); continue
      fi
      if [[ "$a" == --ref ]]; then skip=1; continue; fi
      args+=("$a")
    done
    if [[ "$p" == antigravity && $nref -gt 3 ]]; then say "antigravity takes 3 references; using the first 3 of $nref"; fi
    # The painter prints the file it delivered, which keeps its real extension
    # when this machine cannot convert it (no Pillow, no sips).
    set +e
    got="$(bash "$here/${p}-image" "$prompt" "$out" ${args[@]+"${args[@]}"})"
    rc=$?
    set -e
    if [[ -n "$got" ]]; then echo "$got"; fi
    if [[ $rc -eq 0 ]]; then
      python3 "$here/library" add "${got:-$out}" >/dev/null || true   # index it; never fails the image
      return 0
    fi
    [[ $rc -eq 4 ]] && mark_off "$p"   # the plan lacks this feature (e.g. image gen not on this tier)
    [[ $rc -eq 2 ]] && return 2
    [[ $rc -eq 5 ]] && return 5   # painted but not delivered: the plan already paid, never paint it twice
    if [[ "$want" == auto ]]; then say "$p failed (exit $rc); trying the next painter"; else return $rc; fi
  done
  say "every connected painter failed"; return 1
}

# Side-by-side sheet of several images with labels. Needs Pillow; without it, says so and skips.
contact_sheet() {  # contact_sheet <out.jpg> <label=path>...
  local out="$1"; shift
  if ! python3 -c 'import PIL' 2>/dev/null; then
    say "no side-by-side sheet: it needs Pillow (python3 -m pip install --user pillow); every image is still saved"
    return 0
  fi
  python3 - "$out" "$@" <<'PY' 2>/dev/null || { say "could not build the side-by-side sheet; every image is still saved"; return 0; }
import sys
from PIL import Image, ImageDraw, ImageFont
out, items = sys.argv[1], [a.split("=", 1) for a in sys.argv[2:]]
try: font = ImageFont.truetype("/System/Library/Fonts/HelveticaNeue.ttc", 28)
except Exception: font = ImageFont.load_default()
H = 640; tiles = []
for label, path in items:
    try: im = Image.open(path).convert("RGB")
    except Exception: continue
    tiles.append((label, im.resize((max(1, int(im.width * H / im.height)), H))))
if not tiles: sys.exit(0)
per_row = 3 if len(tiles) > 4 else len(tiles)
rows = [tiles[i:i + per_row] for i in range(0, len(tiles), per_row)]
W = max(sum(t.width for _, t in r) + 20 * (len(r) - 1) for r in rows)
sheet = Image.new("RGB", (W, len(rows) * (H + 60)), (255, 255, 255)); d = ImageDraw.Draw(sheet); y = 0
for r in rows:
    x = 0
    for label, t in r:
        d.text((x + 6, y + 14), label, fill=(30, 30, 30), font=font); sheet.paste(t, (x, y + 56)); x += t.width + 20
    y += H + 60
sheet.save(out, quality=86); print(out)
PY
}

cmd="${1:-help}"; [[ $# -gt 0 ]] && shift
case "$cmd" in
  image|draw)
    [[ $# -ge 2 ]] || usage
    prompt="$1"; out="$2"; shift 2
    painter="$(norm_painter "${SUBPOWERS_PAINTER:-auto}")"; args=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --painter) [[ $# -ge 2 ]] || usage; painter="$(norm_painter "$2")"; shift 2 ;;
        --refs)
          [[ $# -ge 2 ]] || usage
          rf="$(ref_files "$2")" || exit 3
          while IFS= read -r f; do [[ -n "$f" ]] && args+=(--ref "$f"); done <<< "$rf"
          shift 2 ;;
        *) args+=("$1"); shift ;;
      esac
    done
    case "$painter" in
      auto|chatgpt|antigravity|grok) paint "$painter" "$prompt" "$out" ${args[@]+"${args[@]}"} ;;
      all)
        stem="${out%.*}"; ext="${out##*.}"; pids=(); labels=()
        export SUBPOWERS_BATCH="${SUBPOWERS_BATCH:-$(date +%Y%m%d-%H%M%S)-$$}"
        for p in $(connected); do
          ( paint "$p" "$prompt" "${stem}-${p}.${ext}" ${args[@]+"${args[@]}"} ) &
          pids+=($!); labels+=("$p")
        done
        [[ ${#pids[@]} -gt 0 ]] || { say "no painter is connected. Run: subpowers doctor"; exit 3; }
        items=(); i=0; ok=0
        for pid in "${pids[@]}"; do
          p="${labels[$i]}"; i=$((i+1))
          if wait "$pid"; then ok=$((ok+1)); items+=("$p=${stem}-${p}.${ext}"); else say "$p did not finish; the others still count"; fi
        done
        [[ $ok -gt 0 ]] || exit 1
        contact_sheet "${stem}-all.jpg" "${items[@]}" >/dev/null
        if [[ -f "${stem}-all.jpg" ]]; then echo "${stem}-all.jpg"; fi
        ;;
      *) say "unknown painter '$painter' (chatgpt, antigravity, grok, all)"; exit 2 ;;
    esac
    ;;
  sheet)
    [[ $# -ge 2 ]] || usage
    name="$1"; out="$2"; shift 2
    prompt="Character reference sheet of the person in the reference photos, for keeping them consistent across future images. \
One clean studio sheet on a plain light-gray seamless background, even soft light, the same outfit in every view: \
full-body front view, full-body left profile, full-body right three-quarter view, full-body back view, \
and a large head-and-shoulders close-up of the face looking at the camera. Keep the exact face, skin tone, hair and build. \
Photorealistic, evenly spaced, no text, no labels, no watermark."
    exec bash "$here/subpowers" image "$prompt" "$out" --refs "$name" --size "${SUBPOWERS_SHEET_SIZE:-1536x1024}" "$@"
    ;;
  storyboard)
    [[ $# -ge 2 ]] || usage
    shots="$1"; outdir="$2"; shift 2
    [[ -f "$shots" ]] || { say "shot list not found: $shots (one shot description per line)"; exit 2; }
    painter="$(norm_painter "${SUBPOWERS_PAINTER:-auto}")"; style=""; size="1536x1024"; refargs=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --painter) painter="$(norm_painter "$2")"; shift 2 ;;
        --style) style="$2"; shift 2 ;;
        --size) size="$2"; shift 2 ;;
        --refs) refargs+=(--refs "$2"); shift 2 ;;
        --ref) refargs+=(--ref "$2"); shift 2 ;;
        *) say "unknown storyboard option: $1"; exit 2 ;;
      esac
    done
    if [[ "$painter" == all ]]; then say "storyboard uses one painter per board; pick one or leave auto"; exit 2; fi
    mkdir -p "$outdir"; n=0; pids=(); files=()
    max="${SUBPOWERS_PARALLEL:-3}"
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ -z "${line// /}" || "$line" == \#* ]] && continue
      n=$((n+1)); f="$outdir/shot-$(printf '%02d' $n).png"; files+=("Shot $n=$f")
      ( bash "$here/subpowers" image "Storyboard frame, shot $n. $line. ${style}${style:+. }Cinematic still, no text, no letters." "$f" \
          --painter "$painter" --size "$size" ${refargs[@]+"${refargs[@]}"} >/dev/null ) &
      pids+=($!)
      if [[ ${#pids[@]} -ge $max ]]; then wait "${pids[0]}" || say "a shot failed; continuing"; pids=("${pids[@]:1}"); fi
    done < "$shots"
    for pid in ${pids[@]+"${pids[@]}"}; do wait "$pid" || say "a shot failed; continuing"; done
    [[ $n -gt 0 ]] || { say "the shot list is empty"; exit 2; }
    have=()
    for it in "${files[@]}"; do
      f="${it#*=}"; [[ -f "$f" ]] || f="${f%.png}.jpg"   # delivered as jpg where nothing can convert it
      [[ -f "$f" ]] && have+=("${it%%=*}=$f")
    done
    say "${#have[@]} of $n shots painted"
    contact_sheet "$outdir/storyboard.jpg" ${have[@]+"${have[@]}"} >/dev/null
    if [[ -f "$outdir/storyboard.jpg" ]]; then echo "$outdir/storyboard.jpg"; else echo "$outdir"; fi
    ;;
  refs)
    sub="${1:-list}"; [[ $# -gt 0 ]] && shift
    case "$sub" in
      add)
        [[ $# -ge 2 ]] || { say "usage: subpowers refs add NAME IMG..."; exit 2; }
        name="$1"; shift; dir="$HOME_DIR/refs/$name"; mkdir -p "$dir"
        for img in "$@"; do
          [[ -f "$img" ]] || { say "missing: $img"; continue; }
          base="$(basename "$img")"; ext="$(printf '%s' "${base##*.}" | tr '[:upper:]' '[:lower:]')"
          if [[ "$ext" == heic || "$ext" == heif ]] && command -v sips >/dev/null 2>&1; then
            sips -s format jpeg "$img" --out "$dir/${base%.*}.jpg" >/dev/null && echo "$dir/${base%.*}.jpg"
          else cp "$img" "$dir/$base" && echo "$dir/$base"; fi
        done
        ;;
      list)
        if [[ $# -ge 1 ]]; then ref_files "$1"; else ls -1 "$HOME_DIR/refs" 2>/dev/null || say "no reference sets yet"; fi
        ;;
      path) [[ $# -ge 1 ]] || usage; echo "$HOME_DIR/refs/$1" ;;
      *) say "refs: add | list | path"; exit 2 ;;
    esac
    ;;
  slideshow|slider) exec python3 "$here/slideshow" "$@" ;;
  library|lib) exec python3 "$here/library" "$@" ;;
  doctor) exec bash "$here/doctor" "$@" ;;
  powers)
    for p in $ORDER; do
      if has "$p"; then printf 'image  %-12s ON\n' "$p"; else printf 'image  %-12s OFF  (subpowers doctor shows how to connect it)\n' "$p"; fi
    done
    ;;
  update)
    root="$(cd "$here/.." && pwd)"
    # core.fileMode=false: the installer's chmod is not a local edit; real edits still stop the pull.
    if [[ -d "$root/.git" ]]; then git -C "$root" -c core.fileMode=false pull --ff-only && bash "$root/install.sh" --no-doctor
    else say "not a git install; re-run the installer from a fresh download"; exit 1; fi
    ;;
  help|-h|--help) usage 0 ;;
  *) say "unknown command '$cmd'"; usage ;;
esac
