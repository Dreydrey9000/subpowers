#!/usr/bin/env python3
"""library: one searchable index of every image subpowers makes.

Every painted image gets one JSON line in $SUBPOWERS_HOME/library.jsonl (default
~/.subpowers/library.jsonl): where the file is, a content hash, and tags read from its
receipt (painter, image model, helper model and effort, prompt, references, sizes,
C2PA signer) plus your own tags. Images stay where you saved them; nothing is copied.

Usage:
  library add IMG... [--tags k=v,k=v] [--batch ID]   index images (subpowers does this after every paint)
  library find [WORDS...] [--painter P] [--tag k=v] [--limit N] [--json]
  library path                                       print the index file

After each add, an executable hook runs if present: $SUBPOWERS_LIBRARY_HOOK, else
$SUBPOWERS_HOME/hooks/after-image. It gets: <image> <receipt or ""> <id>. Use it to back
images up (B2, S3, Drive). A failing hook never fails the image.
"""
import argparse
import datetime as dt
import hashlib
import json
import os
import re
import subprocess
import sys

HOME = os.environ.get("SUBPOWERS_HOME") or os.path.expanduser("~/.subpowers")
INDEX = os.path.join(HOME, "library.jsonl")
FIELDS = {  # receipt line prefix -> row key (the three painters write slightly different receipts)
    "driver model": "driver",
    "image model": "image_model",
    "C2PA": "c2pa",
    "requested size": "requested_size",
    "delivered size": "delivered_size",
    "painter size": "painter_size",
    "references": "refs",
    "tool": "tool",
    "door": "door",
}


def receipt_of(img):
    stem = os.path.splitext(img)[0]
    for cand in (stem + ".prompt.txt", img + ".prompt.txt"):
        if os.path.isfile(cand):
            return cand
    return ""


def parse_receipt(path):
    row = {}
    if not path:
        return row
    text = open(path, errors="replace").read()
    m = re.search(r"PROMPT \(as given\):\n(.*?)(?:\n\n|\Z)", text, re.S)
    if m:
        row["prompt"] = m.group(1).strip()
    for line in text.splitlines():
        s = line.strip()
        for prefix, key in FIELDS.items():
            if s.startswith(prefix + ":") and key not in row:
                row[key] = s.split(":", 1)[1].strip()
    d = row.get("door", "")
    for p in ("chatgpt", "antigravity", "grok"):
        if p in d:
            row["painter"] = p
    eff = re.search(r"(?:reasoning|effort) (low|medium|high|xhigh|max)", row.get("driver", ""))
    if eff:
        row["effort"] = eff.group(1)
    if row.get("driver"):
        row["driver"] = row["driver"].split(" ")[0]
    im = row.get("image_model", "")
    if "| C2PA says:" in im:
        model, c2pa = im.split("| C2PA says:", 1)
        row["image_model"] = model.strip()
        row.setdefault("c2pa", c2pa.strip())
    return row


def dims(path):
    try:
        from PIL import Image
        with Image.open(path) as im:
            return im.width, im.height
    except Exception:
        return None, None


def parse_tags(s):
    tags = {}
    for part in filter(None, (s or "").split(",")):
        k, _, v = part.partition("=")
        tags[k.strip()] = v.strip()
    return tags


def load():
    rows = []
    if os.path.isfile(INDEX):
        for line in open(INDEX, errors="replace"):
            try:
                rows.append(json.loads(line))
            except ValueError:
                pass
    return rows


def add(images, tags, batch):
    os.makedirs(HOME, exist_ok=True)
    known = {(r.get("id"), r.get("path")) for r in load()}
    hook = os.environ.get("SUBPOWERS_LIBRARY_HOOK") or os.path.join(HOME, "hooks", "after-image")
    for img in images:
        img = os.path.abspath(img)
        if not os.path.isfile(img):
            print(f"library: missing {img}", file=sys.stderr)
            continue
        h = hashlib.sha256(open(img, "rb").read()).hexdigest()[:16]
        if (h, img) in known:
            continue
        rec = receipt_of(img)
        w, hgt = dims(img)
        row = {"id": h, "ts": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
               "path": img, "receipt": rec, "bytes": os.path.getsize(img), "width": w, "height": hgt}
        row.update(parse_receipt(rec))
        if tags:
            row["tags"] = tags
        if batch:
            row["batch"] = batch
        with open(INDEX, "a") as f:
            f.write(json.dumps(row, ensure_ascii=False) + "\n")
        print(h)
        if os.path.isfile(hook) and os.access(hook, os.X_OK):
            try:
                subprocess.run([hook, img, rec, h], timeout=120, check=False)
            except Exception as e:
                print(f"library: hook failed ({e}); the image is indexed anyway", file=sys.stderr)


def find(words, painter, tag, limit, as_json):
    rows = load()
    want_tags = parse_tags(",".join(tag or []))
    out = []
    for r in reversed(rows):
        hay = json.dumps(r, ensure_ascii=False).lower()
        if any(w.lower() not in hay for w in words):
            continue
        if painter and r.get("painter") != painter:
            continue
        if any((r.get("tags") or {}).get(k) != v for k, v in want_tags.items()):
            continue
        out.append(r)
        if len(out) >= limit:
            break
    if as_json:
        print(json.dumps(out, indent=2, ensure_ascii=False))
        return
    for r in out:
        t = ",".join(f"{k}={v}" for k, v in (r.get("tags") or {}).items())
        print(f"{r['ts'][:16]}  {r.get('painter', '?'):<11} {r.get('driver', ''):<22} {r['path']}"
              + (f"  [{t}]" if t else ""))
        if r.get("prompt"):
            print(f"    {r['prompt'][:140]}")
    if not out:
        print("library: nothing matched", file=sys.stderr)


def main():
    ap = argparse.ArgumentParser(prog="library")
    sub = ap.add_subparsers(dest="cmd", required=True)
    a = sub.add_parser("add"); a.add_argument("images", nargs="+"); a.add_argument("--tags", default=os.environ.get("SUBPOWERS_TAGS", ""))
    a.add_argument("--batch", default=os.environ.get("SUBPOWERS_BATCH", ""))
    f = sub.add_parser("find"); f.add_argument("words", nargs="*"); f.add_argument("--painter"); f.add_argument("--tag", action="append")
    f.add_argument("--limit", type=int, default=20); f.add_argument("--json", action="store_true")
    sub.add_parser("path")
    x = ap.parse_args()
    if x.cmd == "add":
        add(x.images, parse_tags(x.tags), x.batch)
    elif x.cmd == "find":
        find(x.words, x.painter, x.tag, x.limit, x.json)
    else:
        print(INDEX)


if __name__ == "__main__":
    main()
